ANTHROPIC_API_KEY=your_api_key_here
PORT=3333
NODE_ENV=development

# Pipeline — Google Sheets
# 1. צור Google Service Account: console.cloud.google.com → APIs → Sheets API
# 2. הורד את קובץ ה-JSON ושמור אותו כ: server/google-service-account.json
# 3. שתף את ה-Spreadsheet עם ה-email של ה-Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json

# תיקיית יצוא (ברירת מחדל: ~/Videos)
VIDEOS_OUTPUT_DIR=~/Videos
